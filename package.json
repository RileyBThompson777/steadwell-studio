{
  "name": "steadwell-studio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Steadwell Studio agency website and reusable foundation for client websites.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run build && node --test \"tests/unit/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.6",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.63.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
