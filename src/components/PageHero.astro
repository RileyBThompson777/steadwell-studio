---
/** Large editorial introduction used at the top of inner pages. */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 data-reveal style="--reveal-delay: 80ms"><Fragment set:html={title} /></h1>
    {lede && <p class="lede" data-reveal style="--reveal-delay: 160ms">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3.5rem, 2rem + 6vw, 8rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-bottom: 1px solid var(--c-line);
  }
  h1 {
    margin-top: 1.25rem;
    max-width: 16ch;
  }
  .lede {
    margin-top: 1.75rem;
    max-width: 44ch;
  }
</style>
