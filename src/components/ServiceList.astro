---
/** Editorial list of included services. `compact` shows summaries only. */
import { services } from '../data/services';

interface Props {
  compact?: boolean;
  limit?: number;
}
const { compact = false, limit } = Astro.props;
const items = limit ? services.slice(0, limit) : services;
---

<ol class:list={['service-list', { 'service-list--compact': compact }]} role="list">
  {
    items.map((s, i) => (
      <li class="service-list__item" id={s.id} data-reveal style={`--reveal-delay: ${(i % 3) * 70}ms`}>
        <span class="service-list__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3>{s.title}</h3>
        <p class="service-list__summary">{s.summary}</p>
        {!compact && <p class="service-list__detail">{s.detail}</p>}
      </li>
    ))
  }
</ol>

<style>
  .service-list {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--c-line);
  }
  .service-list__item {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.9rem;
    border-bottom: 1px solid var(--c-line);
  }
  .service-list__num {
    font-family: var(--font-display);
    color: var(--c-sage-ink);
  }
  :global(.theme-forest) .service-list__num {
    color: var(--c-sage);
  }
  h3 {
    font-size: var(--step-2);
  }
  .service-list__summary {
    color: var(--ink-soft);
    max-width: 48ch;
  }
  .service-list__detail {
    max-width: 56ch;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  @media (min-width: 48rem) {
    .service-list {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 3rem;
    }
  }
  @media (min-width: 64rem) {
    .service-list--compact {
      grid-template-columns: repeat(3, 1fr);
    }
    .service-list:not(.service-list--compact) .service-list__item {
      grid-template-columns: 3rem 1fr;
      column-gap: 1rem;
    }
    .service-list:not(.service-list--compact) .service-list__item > :not(.service-list__num) {
      grid-column: 2;
    }
    .service-list:not(.service-list--compact) .service-list__num {
      grid-row: 1;
      padding-top: 0.2rem;
    }
  }
</style>
